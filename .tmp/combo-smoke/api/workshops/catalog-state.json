  "services": [
    {
      "serviceId": "tax-filing",
      "workshopId": "enterprise-tax",
      "status": "active",
      "displayName": {
        "zh": "香港有限公司季度报税",
        "en": "Hong Kong Quarterly Filing"
      },
      "summary": {
        "zh": "启动后先由系统插入询问信息消息，再由 Codex 收集报税主体、期间、材料和审批要求，随后接管浏览器完成申报。",
        "en": "After launch, the system inserts the information-collection message and Codex gathers the filing entity, period, materials, and approval rules before taking over the browser."
      },
      "authRequirementText": {
        "zh": "企业邮箱 OTP / 财务文件只读挂载 / 最终提交审批",
        "en": "Enterprise OTP / readonly finance files / final-submit approval"
      },
      "estimatedDuration": "04-08 min",
      "targetPathHint": "/workspace/tax-q2/",
      "outputContractSummary": {
        "zh": "回执、执行总结、截图与审计日志会回写到当前任务路径。",
        "en": "Receipts, execution summaries, screenshots, and audit logs are written back into the task path."
      },
      "launchMode": "instant-conversation",
      "requiredBindings": {
        "firstPartyMcpIds": [
          "mcp.browser.playwright"
        ],
        "externalConnectorRefs": [
          "workspace:notion-sse"
        ],
        "credentialIds": [
          "cred_browser_storage_state",
          "cred_tax_notice_folder"
        ]
      },
      "linkedInstanceHint": "tax-q2",
      "visibleInContexts": [
        "harbor-finance"
      ]
    },
    {
