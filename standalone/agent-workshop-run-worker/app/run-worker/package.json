{
  "name": "@lingban/run-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:local": "tsc -p tsconfig.json",
    "build": "pnpm -C ../.. --filter @lingban/config --filter @lingban/contracts --filter @lingban/domain-models --filter @lingban/mcp --filter @lingban/shared --filter @lingban/session-pack --filter @lingban/container-bridge build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:daemon": "node dist/daemon.js",
    "test:blank-bootstrap": "node --test tests/blank-session-bootstrap.test.mjs",
    "test:compiled": "node --test tests/blank-session-bootstrap.test.mjs tests/daemon-processor.test.mjs tests/bridge-runner.test.mjs tests/container-runtime.test.mjs tests/egress-proxy.test.mjs tests/ops-http.test.mjs tests/queue-event-telemetry.test.mjs tests/session-capture-orchestrator.test.mjs tests/session-pack-materializer.test.mjs",
    "test": "pnpm build && pnpm test:compiled"
  },
  "dependencies": {
    "@lingban/config": "workspace:*",
    "@lingban/container-bridge": "workspace:*",
    "@lingban/contracts": "workspace:*",
    "@lingban/domain-models": "workspace:*",
    "@lingban/mcp": "workspace:*",
    "@lingban/session-pack": "workspace:*",
    "@lingban/shared": "workspace:*",
    "bullmq": "^5.58.5",
    "fast-glob": "3.3.3",
    "tar": "7.5.20",
    "zod": "^4.1.5",
    "zstd-codec": "0.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "~5.8.3"
  }
}
