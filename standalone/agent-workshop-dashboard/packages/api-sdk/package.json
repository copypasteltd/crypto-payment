{
  "name": "@lingban/api-sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm -C ../.. --filter @lingban/contracts build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@lingban/contracts": "workspace:*"
  }
}
