{
  "name": "@lingban/session-pack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke:compiled": "node --test tests/*.test.mjs",
    "test:smoke": "pnpm build && pnpm test:smoke:compiled"
  },
  "dependencies": {
    "minimatch": "10.2.5",
    "tar-stream": "3.2.0",
    "zod": "^4.1.5",
    "zstd-codec": "0.1.5"
  },
  "devDependencies": {
    "@types/tar-stream": "3.1.4"
  }
}
