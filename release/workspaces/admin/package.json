{
  "name": "agent-workshop-admin-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "core-js",
      "core-js-pure",
      "esbuild",
      "msgpackr-extract",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "turbo": "^2.0.14",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "dev": "pnpm -C app/admin run dev",
    "lint": "pnpm -C app/admin run lint",
    "typecheck": "pnpm -C app/admin run typecheck",
    "build": "pnpm -C app/admin run build",
    "preview": "pnpm -C app/admin run preview",
    "validate": "pnpm run typecheck && pnpm run build"
  }
}
