LINGBAN_RUNS_DIR=.lingban-data/worker/runs
LINGBAN_CONTAINER_BRIDGE_CLI=
LINGBAN_API_BASE_URL=http://127.0.0.1:3100
LINGBAN_RUNTIME_API_BASE_URL=http://127.0.0.1:3100
LINGBAN_INTERNAL_AUTH_TOKEN=replace-with-a-long-random-token
CODEX_RUNTIME_PROTOCOL=app-server
CODEX_APP_SERVER_REQUEST_TIMEOUT_MS=30000
LINGBAN_WORKER_OPS_HOST=127.0.0.1
LINGBAN_WORKER_OPS_PORT=3901
LINGBAN_WORKER_OPS_TOKEN=
LINGBAN_WORKER_OPS_PROBE_TIMEOUT_MS=1000
LINGBAN_RUNTIME_DISPATCH_MODE=bullmq
LINGBAN_RUNTIME_LAUNCH_MODE=docker
LINGBAN_RUNTIME_MAX_CONCURRENT_RUNS=2
LINGBAN_RUNTIME_ORPHAN_GRACE_MS=15000
LINGBAN_TERMINAL_WORKSPACE_TTL_MS=900000
LINGBAN_REDIS_URL=redis://127.0.0.1:6379/0
LINGBAN_RUNTIME_QUEUE_PREFIX=lingban
LINGBAN_RUNTIME_START_QUEUE_NAME=run.start
LINGBAN_RUNTIME_CLEANUP_QUEUE_NAME=run.cleanup
LINGBAN_RUNTIME_START_DLQ_QUEUE_NAME=run.start.dlq
LINGBAN_RUNTIME_CLEANUP_DLQ_QUEUE_NAME=run.cleanup.dlq
LINGBAN_RUNTIME_START_JOB_ATTEMPTS=3
LINGBAN_RUNTIME_START_JOB_BACKOFF_MS=2000
LINGBAN_RUNTIME_CLEANUP_JOB_ATTEMPTS=5
LINGBAN_RUNTIME_CLEANUP_JOB_BACKOFF_MS=5000
LINGBAN_DOCKER_BIN=docker
LINGBAN_RUNTIME_STARTUP_TIMEOUT_MS=15000
LINGBAN_PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
LINGBAN_RUNTIME_EGRESS_PROXY_ENABLED=false
LINGBAN_RUNTIME_EGRESS_ALLOWED_BASE_URLS=[]
LINGBAN_RUNTIME_EGRESS_NO_PROXY_HOSTS=127.0.0.1,localhost,host.docker.internal
LINGBAN_RUNTIME_EGRESS_FIREWALL_ENABLED=false
LINGBAN_RUNTIME_EGRESS_FIREWALL_ALLOW_DNS=true
LINGBAN_MCP_STDIO_ALLOWED_PATH_PREFIXES=[]
LINGBAN_BRIDGE_PORT=3800
LINGBAN_RUNNER_IMAGE=ghcr.io/lingban/runner:latest
LINGBAN_RUNNER_BASE_IMAGE=
LINGBAN_RUNNER_CPUS=2
LINGBAN_RUNNER_MEMORY=4g
LINGBAN_RUNNER_PIDS_LIMIT=512
LINGBAN_RUNNER_NETWORK=lingban-egress-default
