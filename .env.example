API_HOST=127.0.0.1
API_PORT=3100
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lingban_workshop
LINGBAN_DATA_DIR=.lingban-data/api
LINGBAN_CATALOG_STORE=file
LINGBAN_WORKSHOP_CATALOG_STORE=file
LINGBAN_CREATOR_STORE=file
LINGBAN_RUNS_STORE=file
LINGBAN_RUN_EVENTS_STORE=file
LINGBAN_INTERNAL_CALLBACKS_STORE=file
LINGBAN_AUTH_STORE=file
LINGBAN_WECHAT_MINI_PROGRAM_APP_ID=
LINGBAN_WECHAT_MINI_PROGRAM_APP_SECRET=
LINGBAN_WECHAT_MINI_PROGRAM_API_BASE_URL=https://api.weixin.qq.com
LINGBAN_WECHAT_MINI_PROGRAM_REQUEST_TIMEOUT_MS=5000
LINGBAN_UPLOADS_STORE=file
LINGBAN_RUN_FILES_STORE=file
LINGBAN_BRIDGE_REGISTRY_STORE=file
LINGBAN_OBJECT_STORAGE_DRIVER=filesystem
LINGBAN_OBJECT_STORAGE_ROOT=.lingban-data/objects
LINGBAN_INTERNAL_AUTH_TOKEN=replace-with-a-long-random-token
LINGBAN_BRIDGE_REGISTRATION_STALE_AFTER_MS=20000
LINGBAN_BRIDGE_REGISTRATION_SWEEP_INTERVAL_MS=5000
LINGBAN_RUNS_DIR=.lingban-data/worker/runs
LINGBAN_RUNTIME_DISPATCH_MODE=embedded
LINGBAN_RUNTIME_LAUNCH_MODE=docker
LINGBAN_RUNTIME_API_BASE_URL=http://127.0.0.1:3100
LINGBAN_RUNTIME_EGRESS_PROXY_ENABLED=false
LINGBAN_RUNTIME_EGRESS_ALLOWED_BASE_URLS=[]
LINGBAN_RUNTIME_EGRESS_NO_PROXY_HOSTS=127.0.0.1,localhost,host.docker.internal
LINGBAN_RUNTIME_EGRESS_FIREWALL_ENABLED=false
LINGBAN_RUNTIME_EGRESS_FIREWALL_ALLOW_DNS=true
LINGBAN_RUNTIME_MAX_CONCURRENT_RUNS=2
LINGBAN_RUNTIME_ORPHAN_GRACE_MS=15000
LINGBAN_TERMINAL_WORKSPACE_TTL_MS=900000
LINGBAN_REDIS_URL=redis://127.0.0.1:6379/0
LINGBAN_RUNTIME_QUEUE_PREFIX=lingban
LINGBAN_RUNTIME_START_QUEUE_NAME=run.start
LINGBAN_RUNTIME_CLEANUP_QUEUE_NAME=run.cleanup
LINGBAN_RUNTIME_START_DLQ_QUEUE_NAME=run.start.dlq
LINGBAN_RUNTIME_CLEANUP_DLQ_QUEUE_NAME=run.cleanup.dlq
LINGBAN_RUNTIME_START_JOB_ATTEMPTS=3
LINGBAN_RUNTIME_START_JOB_BACKOFF_MS=2000
LINGBAN_RUNTIME_CLEANUP_JOB_ATTEMPTS=5
LINGBAN_RUNTIME_CLEANUP_JOB_BACKOFF_MS=5000
LINGBAN_MCP_STDIO_ALLOWED_PATH_PREFIXES=[]
LINGBAN_MCP_STDIO_REQUIRE_REF_SHA256=true
LINGBAN_RUNNER_DROP_ROOT_ENABLED=true
LINGBAN_RUNNER_UID=
LINGBAN_RUNNER_GID=
LINGBAN_CREDENTIAL_BROKER_PROVIDER=local-envelope
LINGBAN_CREDENTIAL_BROKER_ACTIVE_KEY_ID=local-dev
LINGBAN_CREDENTIAL_BROKER_KEYS_JSON={"local-dev":"lingban-dev-master-key"}
LINGBAN_CREDENTIAL_BROKER_MASTER_KEY=lingban-dev-master-key
LINGBAN_CREDENTIAL_BROKER_LEASE_TTL_SECONDS=300
LINGBAN_CREDENTIAL_BROKER_REQUEST_TIMEOUT_MS=5000
LINGBAN_CREDENTIAL_BROKER_AWS_REGION=
LINGBAN_CREDENTIAL_BROKER_AWS_KMS_KEY_ID=
LINGBAN_CREDENTIAL_BROKER_AWS_ENDPOINT=
LINGBAN_CREDENTIAL_BROKER_AWS_ACCESS_KEY_ID=
LINGBAN_CREDENTIAL_BROKER_AWS_SECRET_ACCESS_KEY=
LINGBAN_CREDENTIAL_BROKER_AWS_SESSION_TOKEN=
LINGBAN_CREDENTIAL_BROKER_VAULT_BASE_URL=
LINGBAN_CREDENTIAL_BROKER_VAULT_TOKEN=
LINGBAN_CREDENTIAL_BROKER_VAULT_NAMESPACE=
LINGBAN_CREDENTIAL_BROKER_VAULT_TRANSIT_MOUNT=transit
LINGBAN_CREDENTIAL_BROKER_VAULT_KEY_TYPE=aes256-gcm96
LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACKS_JSON={}
LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACK_SWEEP_INTERVAL_MS=60000
LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACK_MAX_ATTEMPTS=8
LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACK_BACKOFF_MS=5000
# OAuth callback auth example:
# LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACKS_JSON={"seedance":{"url":"https://provider.example/callbacks/credential","statuses":["disabled","revoked"],"auth":{"type":"oauth-client-credentials","tokenUrl":"https://provider.example/oauth/token","scope":"workflows.write","clientAuthentication":{"method":"client_secret_basic","clientId":"seedance-client","clientSecret":"replace-me"}},"payload":{"eventType":"credential.lifecycle.changed","eventVersion":1,"includeAttemptMetadata":true}}}
# mTLS transport example:
# LINGBAN_CREDENTIAL_LIFECYCLE_CALLBACKS_JSON={"seedance":{"url":"https://provider.example/callbacks/credential","statuses":["disabled"],"auth":{"type":"bearer","token":"replace-me"},"transport":{"callbackTls":{"caPem":"-----BEGIN CERTIFICATE-----\\n...","certPem":"-----BEGIN CERTIFICATE-----\\n...","keyPem":"-----BEGIN PRIVATE KEY-----\\n...","rejectUnauthorized":true}}}}
LINGBAN_RUNNER_IMAGE=ghcr.io/lingban/runner:latest
VITE_API_BASE_URL=http://127.0.0.1:3100
# 微信小程序生产构建必须覆盖为已加入 request 合法域名的 HTTPS API 地址。
TARO_APP_API_BASE_URL=http://127.0.0.1:3100
CODEX_BIN=codex
