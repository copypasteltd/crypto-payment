NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3100
LINGBAN_DATA_DIR=/srv/lingban/data/api
DATABASE_URL=postgres://lingban:change-me@127.0.0.1:5432/lingban_workshop

LINGBAN_CATALOG_STORE=postgres
LINGBAN_WORKSHOP_CATALOG_STORE=postgres
LINGBAN_CREATOR_STORE=postgres
LINGBAN_RUNS_STORE=postgres
LINGBAN_BATCH_RUNS_STORE=postgres
LINGBAN_RUN_EVENTS_STORE=postgres
LINGBAN_INTERNAL_CALLBACKS_STORE=postgres
LINGBAN_AUTH_STORE=postgres
LINGBAN_UPLOADS_STORE=postgres
LINGBAN_RUN_FILES_STORE=postgres
LINGBAN_BRIDGE_REGISTRY_STORE=postgres
LINGBAN_CREDENTIALS_STORE=postgres
LINGBAN_MCP_STORE=postgres
LINGBAN_QUOTA_STORE=postgres
LINGBAN_BILLING_STORE=postgres
LINGBAN_NOTIFICATIONS_STORE=postgres
LINGBAN_FAVORITES_STORE=postgres
LINGBAN_RECENT_STORE=postgres
LINGBAN_SEARCH_STORE=postgres
LINGBAN_SESSION_ARCHIVES_STORE=postgres

LINGBAN_AUTH_MODE=required
LINGBAN_AUTH_ACCESS_TTL_SECONDS=900
LINGBAN_AUTH_REFRESH_TTL_SECONDS=2592000

LINGBAN_OBJECT_STORAGE_DRIVER=s3
LINGBAN_OBJECT_STORAGE_BUCKET=lingban-prod
LINGBAN_OBJECT_STORAGE_REGION=ap-east-1
LINGBAN_OBJECT_STORAGE_ENDPOINT=https://s3.example.com
LINGBAN_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
LINGBAN_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
LINGBAN_OBJECT_STORAGE_SESSION_TOKEN=
LINGBAN_OBJECT_STORAGE_FORCE_PATH_STYLE=false
LINGBAN_OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=600

LINGBAN_UPLOAD_MAX_BYTES=52428800
LINGBAN_DOWNLOAD_TICKET_TTL_SECONDS=600
LINGBAN_INTERNAL_AUTH_TOKEN=replace-with-a-long-random-token

LINGBAN_RUNTIME_DISPATCH_MODE=bullmq
LINGBAN_RUNTIME_MAX_CONCURRENT_RUNS=20
LINGBAN_RUNTIME_ORPHAN_GRACE_MS=15000
LINGBAN_TERMINAL_WORKSPACE_TTL_MS=900000

LINGBAN_REDIS_URL=redis://127.0.0.1:6379/0
LINGBAN_RUNTIME_QUEUE_PREFIX=lingban
LINGBAN_RUNTIME_START_QUEUE_NAME=run.start
LINGBAN_RUNTIME_CLEANUP_QUEUE_NAME=run.cleanup

LINGBAN_WORKER_OPS_BASE_URL=http://127.0.0.1:3901
LINGBAN_WORKER_OPS_TOKEN=replace-with-a-worker-ops-token
LINGBAN_WORKER_OPS_PROBE_TIMEOUT_MS=1000
LINGBAN_BRIDGE_CONTROL_PROBE_TIMEOUT_MS=1000
LINGBAN_MCP_PROBE_TIMEOUT_MS=3000

LINGBAN_BRIDGE_REGISTRATION_STALE_AFTER_MS=20000
LINGBAN_BRIDGE_REGISTRATION_SWEEP_INTERVAL_MS=5000

CODEX_BIN=codex
