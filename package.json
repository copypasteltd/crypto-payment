{
  "name": "lingban-workshop-root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build:config": "tsc -p packages/config/tsconfig.json",
    "build:credential": "tsc -p packages/credential/tsconfig.json",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json",
    "build:db": "tsc -p packages/db/tsconfig.json",
    "build:domain-models": "tsc -p packages/domain-models/tsconfig.json",
    "build:files": "tsc -p packages/files/tsconfig.json",
    "build:realtime": "tsc -p packages/realtime/tsconfig.json",
    "build:mcp": "tsc -p packages/mcp/tsconfig.json",
    "build:api-sdk": "tsc -p packages/api-sdk/tsconfig.json",
    "build:session-pack": "tsc -p packages/session-pack/tsconfig.json",
    "build:ui-tokens": "tsc -p packages/ui-tokens/tsconfig.json",
    "build:shared": "pnpm --filter @lingban/config --filter @lingban/contracts --filter @lingban/credential --filter @lingban/db --filter @lingban/files --filter @lingban/shared --filter @lingban/mcp --filter @lingban/domain-models --filter @lingban/api-sdk --filter @lingban/session-pack --filter @lingban/realtime --filter @lingban/ui-tokens build",
    "build:backend:deps": "pnpm --filter @lingban/config --filter @lingban/contracts --filter @lingban/credential --filter @lingban/db --filter @lingban/files --filter @lingban/shared --filter @lingban/mcp --filter @lingban/domain-models --filter @lingban/session-pack build",
    "build:backend": "pnpm build:backend:deps && pnpm -C app/container-bridge build:local && pnpm -C app/run-worker build:local && pnpm -C app/api build:local",
    "build:frontend": "pnpm -C app/dashboard build && pnpm -C app/mobile build:h5",
    "typecheck:backend": "pnpm --filter @lingban/files --filter @lingban/shared build && pnpm --filter @lingban/config --filter @lingban/contracts --filter @lingban/credential --filter @lingban/db --filter @lingban/shared --filter @lingban/mcp --filter @lingban/domain-models --filter @lingban/session-pack --filter @lingban/api --filter @lingban/run-worker --filter @lingban/container-bridge typecheck",
    "typecheck:frontend": "pnpm --filter @lingban/realtime build && pnpm -C app/dashboard typecheck && pnpm -C app/mobile typecheck",
    "lint:frontend": "pnpm -C app/dashboard lint",
    "test:db": "pnpm -C packages/db test:smoke",
    "test:db:compiled": "pnpm -C packages/db test:smoke:compiled",
    "test:files": "pnpm -C packages/files test:smoke",
    "test:files:compiled": "pnpm -C packages/files test:smoke:compiled",
    "test:shared": "pnpm -C packages/shared test:smoke",
    "test:shared:compiled": "pnpm -C packages/shared test:smoke:compiled",
    "test:session-pack": "pnpm -C packages/session-pack test:smoke",
    "test:session-pack:compiled": "pnpm -C packages/session-pack test:smoke:compiled",
    "test:backend:smoke": "pnpm -C app/api test:smoke",
    "test:backend:smoke:compiled": "pnpm -C app/api test:smoke:compiled",
    "test:runtime": "pnpm -C app/run-worker test && pnpm -C app/container-bridge test",
    "test:runtime:compiled": "pnpm -C app/run-worker test:compiled && pnpm -C app/container-bridge test:compiled",
    "ci:backend": "pnpm build:backend && pnpm test:db:compiled && pnpm test:files:compiled && pnpm test:shared:compiled && pnpm test:session-pack:compiled && pnpm test:backend:smoke:compiled",
    "ci:runtime": "pnpm test:runtime:compiled",
    "ci:frontend": "pnpm lint:frontend && pnpm test:e2e",
    "ci:verify": "pnpm ci:backend && pnpm ci:runtime && pnpm ci:frontend",
    "infra:runner:build": "docker build -f infra/docker/runner.Dockerfile -t lingban/runner:local .",
    "infra:api:build": "docker build -f infra/docker/api.Dockerfile -t lingban/api:local .",
    "infra:stack:config": "docker compose -f infra/docker/docker-compose.local.yml --env-file infra/docker/compose.env config",
    "infra:stack:ps": "docker compose -f infra/docker/docker-compose.local.yml --env-file infra/docker/compose.env ps",
    "infra:stack:up": "docker compose -f infra/docker/docker-compose.local.yml --env-file infra/docker/compose.env up -d --build",
    "infra:stack:down": "docker compose -f infra/docker/docker-compose.local.yml --env-file infra/docker/compose.env down -v --remove-orphans",
    "infra:stack:logs": "docker compose -f infra/docker/docker-compose.local.yml --env-file infra/docker/compose.env logs -f postgres redis minio api",
    "infra:worker:start": "node infra/scripts/run-local-worker.mjs",
    "infra:local:up": "node infra/scripts/local-stack.mjs up",
    "infra:local:dev": "node infra/scripts/local-stack.mjs dev",
    "test:e2e:build": "node tests/e2e/build-frontends.mjs",
    "test:e2e": "pnpm test:e2e:build && playwright test -c tests/e2e/playwright.config.mjs",
    "test:e2e:dashboard": "pnpm test:e2e:build && playwright test -c tests/e2e/playwright.config.mjs --project=dashboard",
    "test:e2e:mobile": "pnpm test:e2e:build && playwright test -c tests/e2e/playwright.config.mjs --project=mobile-h5",
    "test:e2e:install": "playwright install chromium",
    "standalone:export": "node infra/scripts/export-standalone-workspace.mjs",
    "standalone:export:all": "node infra/scripts/export-standalone-workspace.mjs all",
    "release:prepare": "node infra/scripts/prepare-production-release.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "turbo": "^2.0.14",
    "typescript": "~5.8.3"
  }
}
